pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')     // Jenkins string credential
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY') // Jenkins string credential
    }

    parameters {
        choice(
            name: 'action',
            choices: ['apply', 'destroy'],
            description: 'Terraform action to perform'
        )
    }

    stages {
        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/Anubhav6205/devops-ci-cd-eks-observability.git'
            }
        }

        stage('Terraform Version') {
            steps {
                sh 'terraform --version'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Terraform') {
                    // Using env vars, no need to pass access_key/secret_key here
                    sh '''
                      set -euo pipefail
                      terraform init -input=false -no-color
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh '''
                      set -euo pipefail
                      terraform validate -no-color
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('Terraform') {
                    sh '''
                      set -euo pipefail
                      terraform plan -input=false -no-color \
                        -var="aws_access_key_id=$AWS_ACCESS_KEY_ID" \
                        -var="aws_secret_access_key=$AWS_SECRET_ACCESS_KEY"
                    '''
                }
            }
        }

        stage('Terraform Apply/Destroy') {
            steps {
                dir('Terraform') {
                    sh '''
                      set -euo pipefail
                      terraform ${action} -auto-approve -input=false -no-color \
                        -var="aws_access_key_id=$AWS_ACCESS_KEY_ID" \
                        -var="aws_secret_access_key=$AWS_SECRET_ACCESS_KEY"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Terraform execution completed successfully!'
        }
        failure {
            echo '❌ Terraform execution failed! Check the logs.'
        }
    }
}
