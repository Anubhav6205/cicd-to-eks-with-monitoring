pipeline {
  agent any
  options { ansiColor('xterm'); timestamps() }
  tools { jdk 'jdk'; nodejs 'nodejs' }
  environment {
    SCANNER_HOME = tool 'sonar-scanner'
    IMAGE_NAME   = 'kubeanu6205/hotstar'
    IMAGE_TAG    = "${env.GIT_COMMIT.take(7)}"
  }
  stages {
    stage('Clean') { steps { cleanWs() } }

    stage('Checkout') {
      steps {
        git branch: 'main',
            credentialsId: 'github-token',
            url: 'https://github.com/Anubhav6205/hoststar-devops.git'
      }
    }

    stage('SonarQube (SAST)') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh '''
            set -euo pipefail
            "$SCANNER_HOME/bin/sonar-scanner" \
              -Dsonar.projectKey=Hotstar \
              -Dsonar.projectName=Hotstar
          '''
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          // fail the pipeline if gate fails
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Dependencies (deterministic)') {
      steps { sh 'npm ci' }
    }

    stage('SCA: OWASP Dependency-Check') {
      steps {
        withCredentials([string(credentialsId: 'NVD_API_KEY', variable: 'NVD_KEY')]) {
          dependencyCheck additionalArguments: "--scan . --format XML --out . --data ./odc-data --nvdApiKey ${NVD_KEY} --disableYarnAudit --disableNodeAudit",
                          odcInstallation: 'DC'
        }
        dependencyCheckPublisher pattern: 'dependency-check-report.xml'
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          sh """
            set -euo pipefail
            docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
          """
        }
      }
    }

    stage('Trivy Image Scan (gate)') {
      steps {
        sh """
          set -euo pipefail
          trivy image --severity HIGH,CRITICAL --exit-code 1 --no-progress ${IMAGE_NAME}:${IMAGE_TAG} | tee trivyimage.txt
        """
      }
    }

    stage('Push Image') {
      steps {
        withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
          sh """
            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
            docker push ${IMAGE_NAME}:${IMAGE_TAG}
            docker push ${IMAGE_NAME}:latest
          """
        }
      }
    }

    // (Optional) Local run for smoke test — better to deploy to K8s instead of Jenkins agent
    // stage('Smoke (container)') { steps { sh 'docker run --rm -d -p 3000:3000 ${IMAGE_NAME}:${IMAGE_TAG}' } }
  }

  post {
    always {
      script {
        def buildStatus = currentBuild.currentResult
        emailext(
          subject: "Pipeline ${buildStatus}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
          body: """<p>Jenkins HOTSTAR CI/CD status</p>
                   <p>Build: ${env.BUILD_NUMBER} • Status: ${buildStatus}</p>
                   <p>URL: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>""",
          // Use a preconfigured Jenkins mailer or a list variable stored in Jenkins, not plain text here
          to: '${DEVOPS_ALERTS_EMAILS}',
          mimeType: 'text/html',
          attachmentsPattern: 'trivyimage.txt,dependency-check-report.xml'
        )
      }
      // cleanup dangling containers/images if you enabled the smoke test
      sh 'docker ps -aq --filter "name=hotstar" | xargs -r docker rm -f || true'
    }
  }
}
